# Copy to .env next to the scripts (never committed), chmod 600, fill in.
# Real environment variables (crontab, shell) override these values.
# vulnAlert.py refuses to run if a required value is missing (see check_config).

# Power Automate webhook for the Teams channel.
# Empty: the script reads .teams_webhook instead. Required with NOTIFY_MODE=filtered.
TEAMS_WEBHOOK_URL=

# all = one email per new KEV entry (current behaviour)
# filtered = SG criteria (MATCH and TO_CHECK -> customer, CC_EMAILS in copy; NO_MATCH -> Teams only)
NOTIFY_MODE=all

# SMTP relay, required. Production values:
SMTP_HOST=relay.itm.lan
SMTP_PORT=25
SMTP_HELLO=p-tvm-ctl-l-01.prod-client.itm.lan
SMTP_FROM=monitoring_cybertools@cybersoc.orangecyberdefense.com
# Optional, not needed with the internal relay: STARTTLS + login when SMTP_USER is set.
# SMTP_USER=
# SMTP_PASSWORD=

# Recipients, comma-separated.
# CUSTOMER_EMAILS: To of every alert (required). CC_EMAILS: copy of every alert,
# and To of the daily summary (internal only).
CUSTOMER_EMAILS=
CC_EMAILS=

# Mode filtered only: also require the type RCE / Authentication Bypass (1 = on).
# Off by default: the CVSS criteria decide alone, the detected type is shown for information.
SG_TYPE_FILTER=0

# Customer exclusion list (products never emailed). Default: exclusions.csv next to the state files.
# EXCLUSIONS_FILE=/home/sysroot/VulnSG/exclusions.csv

# Optional NVD key (50 requests / 30 s instead of 5)
NVD_API_KEY=

# Uncomment to send nothing and save no state (deployment check)
# DRY_RUN=1

# Default: /home/sysroot/VulnSG if it exists, otherwise the scripts' folder
# VULNSG_DIR=/home/sysroot/VulnSG
