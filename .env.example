# Copy to .env (never committed) and fill in.
# Real environment variables (crontab, shell) override these values.

# Power Automate webhook for the Teams channel
TEAMS_WEBHOOK_URL=

# all = one email per new KEV entry (current behaviour)
# filtered = SG criteria (MATCH -> L1, TO_CHECK -> manual review, NO_MATCH -> no email)
NOTIFY_MODE=all

# Required when NOTIFY_MODE=filtered, comma-separated
L1_EMAILS=
REVIEW_EMAILS=

# Optional NVD key (50 requests / 30 s instead of 5)
NVD_API_KEY=

# Uncomment to send nothing and save no state
# DRY_RUN=1

# Defaults to /home/sysroot/VulnSG
# VULNSG_DIR=/home/sysroot/VulnSG
